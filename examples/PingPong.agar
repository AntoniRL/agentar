// Program for simple demonstration of ping-pong behavior

message ping{
    int y;
}

message pong{
    int x;
}

agent child {
    receive ping{
        when (msg._type == msgType_request) then {
            pong msg_ = pong{x: 1};
            send2parent(msg_, msgType_inform);
        }
    }
}

agent mother {
    fields{
        int num_of_msg = 10;
    }
    beliefs {
        int counter = 0;
    }
    initialize {
        agentid agentid_;
        agentid_ = spawn(child);
        ping msg_ = ping{y: 0};
        send(agentid_, msg_, msgType_request);
    }
    rules {
        when (bel.counter == self.num_of_msg) then {
            kill();
        }
    }
    destroy{
        print("I have repaid", bel.counter,"/",self.num_of_msg,"messages with agent", self._children[0]);
    }
    receive pong {
        when () then {
            bel.counter = bel.counter + 1;
            ping msg_ = ping{y: 0};
            send2children(_, msg_, msgType_request);
        }
    }
}
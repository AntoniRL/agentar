// Program demonstrujący czysty model wymiany wiadomości międyz agentami

message ping{
    int x;
}

message pong{
    int x;
}

agent child {
    receive ping{
        when (msg._type == request) then {
            msg_ = pong(x = 1);
            send2parent(msg_, msg_type=inform);
        }
    }
}

agent mother {
    initialize {
        agentid agentid_;
        agentid_ = spawn(child);
        msg_ = ping(x = 0);
        send(agentid_, msg_, msg_type=request);
    }
    beliefs {
        int counter = 0;
    }
    rules {
        when (bel.counter == 10) then {
            print("I have repied", bel.counter,"messages with agent",self._children[0]);
            kill();
        }
    }
    receive pong {
        when () then {
            bel.counter = bel.counter + 1;
            msg_ = ping(x = 0);
            send2children(_, msg_, msg_type=request);
        }
    }
}
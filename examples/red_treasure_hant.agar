// ==== messages ========================
message TASK_REQUEST { dict<tuple<int,int>, int> neighbor_map; tuple<int,int> pos_now; }
message TASK_ASSIGN  { tuple<int,int> pos; }  // (-1,-1) = brak; zadań msg._type == confirm/deny
message TASK_DONE    { tuple<int,int> pos; dict<tuple<int,int>,int> neighbors; int coins_collected;}



// ==== RED TEAM ========================
agent red_scout{
    fields {
        pointer<list<list<int>>> WORLD;
        tuple<int,int> START;
        list<tuple<int,int>> neighbors;
        list<tuple<int,int>> path;
        bool asked = False;
    }
    beliefs {
        int x;
        int y;
        int reword;
        int target;

        dict<tuple<int,int>, int> neighbor_map;
    }
    goals {
        g1: bel.target == (bel.x, bel.y);
    }
    initialize {
        bel.x = self.START[0];
        bel.y = self.START[1];
        bel.reword = 0;
        self.path = [];
        print("Hello red");
    }
    sense {
        bel.neighbor_map = {};
        bel.reword = *self.WORLD[bel.y][bel.x];
        for (int i=0; i<4; i=i+1){
            tuple<int,int> neighbor = (bel.x + self.neighbors[i][0], bel.y + self.neighbors[i][1]);
            if (neighbor[0] < 0 || neighbor[0] >= len(*self.WORLD[0]) || neighbor[1] < 0 || neighbor[1] >= len(*self.WORLD)) continue;
            elif (*self.WORLD[neighbor[1]][neighbor[0]] == -1) continue;
            else  bel.neighbor_map[neighbor] = -2;
        }
    }
    rules {
        when(self.is_goal_achieved == True, len(self.path) == 0 && self.asked == False) then {
            TASK_REQUEST t_rq = TASK_REQUEST(neighbor: bel.neighbor_map, pos: (bel.x, bel.y));
            send2parent(t_rq, msgType_request);
            self.asked = True;
        }
    }
}


// first in first out
agent red_scout_master{
    fields {
        pointer<list<list<int>>> WORLD;
        tuple<int,int> START;
    }
    beliefs {
        dict<tuple<int,int>, int> to_visit;
        dict<tuple<int,int>, int> visited;
        dict<tuple<int,int>, int> reserved;
    }
    goals {
        g1: len(bel.to_visit) == 0;
    }
    initialize {
        bel.visited = {}; bel.reserved = {}; self.to_visit = [];
        spawn(red_scout, {WORLD: self.WORLD, START: self.START, neighbors: [(1,0),(0,1),(-1,0),(0,-1)]});
    }
}



agent red_master{
    fields {
        pointer<list<list<int>>> WORLD;
        tuple<int,int> START;
    }
    beliefs {
        dict<tuple<int, int>, int> map;
        dict<tuple<int, int>, int> reword;

    }
    initialize {
        print("MY TEAM::: RED");
        spawn(red_scout_master, {WORLD: self.WORLD, START: self.START});
    }

}




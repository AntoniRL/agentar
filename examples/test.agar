message clean_room{
    int task;
    float value;
}

agent tok{
    fields{
    }
}

agent tic {
    initialize{
        agentid agentid_;
        sleep(1);
        agentid_ = spawn(tok);
        agentid_ = spawn(tok);
        agentid_ = spawn(tok);
        agentid_ = spawn(tok);
        sleep(1);
        //kill();
    }
    receive clean_room {
        when(msg.type==request) then {
            print(self.id, msg.content.task);
            do clean();
        }
        when() then {
            print("Lets go!");
        }
    }
    action clean(int c): void {
        print("Akcion clean");
    }
}

agent mother {
    fields {
        string nazwisko = "kkk";
        int counter = 2;
    }
    initialize{
        agentid agentid_;
        agentid_ = spawn(tic, ["RRR",0]);
        print("My child name: ", agentid_);
        self.nazwisko = "radomin";
        msg_ = clean_room(task = 10, value = 10.0);
        send(agentid_, msg_, msg_type=request);
        //kill();
    }
    destroy{
        print("Destroy myself...");
    }
    receive clean_room {
        when(msg.type==inform) then {
            print(self.id, msg.content.task);
        }
        when() then {
            print("DONE");
        }
    }
}
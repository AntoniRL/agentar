message clean_room{
    int task;
    float value;
}

agent tic {
    fields {
        string nazwisko = 5;
        int counter;
    }
    initialize{
        print("I am here!", 34);
    }
    destroy{
        print("destroy");
    }
    receive clean_room {
        when(msg.type==request) then {
            print(self.id, msg.content.task);
            do clean();
        }
        when() then {
            print("nie wiem czy to dziala");
        }
    }
    action clean(int c): void {
        print("Akcja clean");
    }
}

agent mother {
    initialize{
        agentid agentid_;
        agentid_ = spawn(tic, ["RRR", 0]);
        msg_ = clean_room(task = "clean");
        send(agentid_, msg_, msg_type=request);
    }
}
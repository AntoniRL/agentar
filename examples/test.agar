message clean_room{
    int task;
    float value;
}

agent tic {
    initialize{
        print("I am here!", 34);
    }
    destroy{
        print("destroy");
    }
    receive clean_room {
        when(msg.type==request) then {
            print(self.id, msg.content.task);
            do clean();
        }
        when() then {
            print("Lets go!");
        }
    }
    action clean(int c): void {
        print("Akcion clean");
    }
}

agent mother {
    fields {
        string nazwisko;
        int counter;
    }
    initialize{
        agentid agentid_;
        agentid_ = spawn(tic, ["RRR",0]);
        msg_ = clean_room(task = 10, value = 10.0);
        send(agentid_, msg_, msg_type=request);
        kill();
    }
    destroy{
        print("Destroy myself...", 10);
    }
    receive clean_room {
        when(msg.type==inform) then {
            print(self.id, msg.content.task);
        }
        when() then {
            print("DONE");
        }
    }
}
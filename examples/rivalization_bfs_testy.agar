        list<list<int>> WORLD_BUF;
        int num_of_worlds;

        list<tuple<tuple<int, int>, tuple<int,int> >> results;   //(red_gold, blue_gold) red up, (red_gold, blue_gold) red down
        int red_first_round = -1;
        int blue_first_round = -1;
        int red_second_round = -1;
        int blue_second_round = -1;
        int res_in_one_game = 0;


        int response = 0;  // in total
        bool first_round = True;
        bool second_round = False;
    }

    initialize {
        del self.results[-1];
        self.num_of_worlds = len(self.WORLDS) - 1; //index from 0 in 

        //logging("WORLD::", self.WORLD);
        //// red down; green up
        //spawn(red_master, {WORLD: &self.WORLD, START: (len(self.WORLD[0])-1, len(self.WORLD)-1 )});
        //spawn(green_master, {WORLD: &self.WORLD, START: (0,0)});
        //// red up; blue down;
        //spawn(red_master, {WORLD: &self.WORLD, START: (0,0)});
        //spawn(green_master, {WORLD: &self.WORLD, START: (len(self.WORLD[0])-1, len(self.WORLD)-1 )});
    }
    rules {
        when (self.res_in_one_game == 4) then {
            print(self.red_first_round, self.blue_first_round, self.red_second_round, self.blue_second_round);
            self.res_in_one_game = 0;
            self.results.add(((self.red_first_round, self.blue_first_round), (self.red_second_round, self.blue_second_round)));
            self.response = self.response + 1;
            self.red_first_round = -1;
            self.blue_first_round = -1;
            self.red_second_round = -1;
            self.blue_second_round = -1;
            self.first_round = True;

        }
        when (self.num_of_worlds >= 0 && self.first_round == True) then {
            self.first_round = False;
            self.WORLD_BUF = self.WORLDS[self.num_of_worlds];
            print("First round RED vs BLUE");
            spawn(red_master, {WORLD: &self.WORLD_BUF, START: (len(self.WORLD_BUF[0])-1, len(self.WORLD_BUF)-1 )});
            spawn(green_master, {WORLD: &self.WORLD_BUF, START: (0,0)});
        }
        when (self.num_of_worlds >= 0 && self.second_round == True) then {
            self.second_round = False;
            self.WORLD_BUF = self.WORLDS[self.num_of_worlds];
            self.num_of_worlds = self.num_of_worlds - 1;
            print("Second round BLUE vs RED");
            spawn(red_master, {WORLD: &self.WORLD_BUF, START: (0,0)});
            spawn(green_master, {WORLD: &self.WORLD_BUF, START: (len(self.WORLD_BUF[0])-1, len(self.WORLD_BUF)-1 )});
        }
        when (self.num_of_worlds < 0 && len(self.results) == len(self.WORLDS)) then {
            print("RESULTS::",self.results);
            kill();
        } 
    }
    receive RED_GOLD_COLECT {
        when (self.red_first_round >= 0 && self.red_second_round == -1) then {
            self.red_second_round = msg.gold;
            self.res_in_one_game = self.res_in_one_game + 1;
            print("2nd round RED::", msg.gold);
        }
        when (self.red_first_round == -1) then {
            self.red_first_round = msg.gold;
            self.res_in_one_game = self.res_in_one_game + 1;
            print("1st round RED::", msg.gold);
            if (self.blue_first_round >= 0) self.second_round = True;
        }
    }
    receive BLUE_GOLD_COLECT {
        when (self.blue_first_round >= 0 && self.blue_second_round == -1) then {
            self.blue_second_round = msg.gold;
            self.res_in_one_game = self.res_in_one_game + 1;
            print("2nd round BLUE::", msg.gold);
        }
        when (self.blue_first_round == -1) then {
            self.blue_first_round = msg.gold;
            self.res_in_one_game = self.res_in_one_game + 1;
            print("1st round BLUE::", msg.gold);
            if (self.red_first_round >= 0) self.second_round = True;
        }
    }
}

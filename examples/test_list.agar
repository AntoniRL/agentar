message ping{
}

agent child {
    receive ping {
        when (msg.type == ask) then {
            msg_ = ping();
            send(self.parent, msg_, msg_type=inform);
        }
    }
}

agent mother {
    fields{
        list mmList;
    }
    initialize{
        for (int i = 0; i < 10; i=i+1) {
            print("Spawning child ", i);
            if (i==5) break;
        }
    }
}
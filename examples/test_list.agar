message ping{
}

agent child {
    receive ping {
        when (msg.type == ask) then {
            msg_ = ping();
            send(self.parent, msg_, msg_type=inform);
        }
    }
}

agent mother {
    fields{
        list mmList;
    }
    initialize{
        agentid agentid_;
        agentid_ = spawn(child);
        msg_ = ping();
        send(agentid_, msg_,  msg_type=ask);
    }
}
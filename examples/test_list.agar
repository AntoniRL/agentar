message ping{
}

agent child {
    receive ping {
        when (msg.msgType == ask) then {
            msg_ = ping();
            send(self.parent, msg_, msg_type=inform);
        }
    }
}

agent mother {
    fields{
        list mmList;
    }
    initialize{
        list myList = [0, 1, 2, 3, 4];
        myList[:2] = [2,2];
        //self.mmList = myList;
        //self.mmList[] = [5,6];
        //string r = 
        //self.mmList[0:][1] = "r";
        //print(type(self.mmList[1][1]));
        print(myList);
        kill();
    }
}
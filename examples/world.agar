message response{
    int number_of_rewords;
}


agent line_founder{
    fields{
        int number_of_fields;
        int my_line;
    }
    destroy{
        msg_ = response(number_of_rewords=bel.number_of_rewords);
        send2parent(msg_, msg_type=deny);
    }
    beliefs{
        int number_of_rewords = 0;
        int my_field = 0;
        bool reword_on_my_field = 0;
    }
    sense{
        bool temp;
        temp = get_from_world(self.my_line, bel.my_field);
        bel.reword_on_my_field = temp;
    }
    goals{
        g1: bel.my_field == (self.number_of_fields - 1); //indexing from 0
        g2: 2==2;
    } merge (g1 && g2)
    rules{
        when () then{
            if (bel.my_field < self.number_of_fields) {
                if (bel.reword_on_my_field) bel.number_of_rewords = bel.number_of_rewords + 1;
                bel.my_field = bel.my_field + 1;    
            }
        }
        when (self._isGoalAchieved) then{
            kill();
        }
    }
}


agent menager_by_lines {
    fields{
        int lines_in_world;
        int fields_in_line;
    }
    initialize{
        for(int i=0; i<self.lines_in_world; i=i+1){
            agentid agentid_;
            agentid_ = spawn(line_founder, [self.fields_in_line, i]);
        }
    }
    beliefs{
        int number_of_rewords = 0;
        int number_of_unswers = 0;
    }
    goals{
        g1: bel.number_of_unswers == self.lines_in_world;
    }
    rules{
        when (self._isGoalAchieved) then {
            print(bel.number_of_unswers, self.lines_in_world);
            msg_ = response(number_of_rewords=bel.number_of_rewords);
            send2parent(msg_, confirm);
        }
    }
    receive response {
        when () then {
            bel.number_of_rewords = bel.number_of_rewords + msg.number_of_rewords;
            bel.number_of_unswers = bel.number_of_unswers + 1;
        }
    }
}


agent mother {
    fields{
        list WORLD;
        int counter = 0;
    }
    initialize{
        // initialize the WORLD
        int world_size = 10;
        for(int i=0; i<world_size; i=i+1){
            list temp_list;
            for(int j=0; j<world_size; j=j+1){
                if ((j+i)%5==0){
                    temp_list[] = 1;
                    self.counter = self.counter + 1;
                } else {
                    temp_list[] = 0;
                }
            }
            self.WORLD[] = temp_list;
        }
        print("Done makeing world! rewords:", self.counter);
        //print(self.WORLD);
        agentid agentid_;
        agentid_ = spawn(menager_by_lines, [1, world_size]);
    }
    receive response{
        when () then {
            print("The agent ", msg._sender, " has found ", msg.number_of_rewords, "/", self.counter," rewords.");
            kill();
        }
    }
}
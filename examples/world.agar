agent finder{
    initialize{
        bool isReword;
        print(isReword);
        isReword = get_from_world(0,0);
        print(isReword);
        set_in_world(1,1,1);
        sleep(2);
        set_in_world(1,1,0);
    }
}

agent mother {
    fields{
        list WORLD;
    }
    initialize{
        self.WORLD = [[1,0],[0,0]];
        print(self.WORLD);
        agentid agentid_;
        agentid_ = spawn(finder);
    }
    goals {
        g1: 1==2;
    }
    rules{
        when () then{
            print(self.WORLD);
        }
    }
}
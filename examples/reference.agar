message set_world{
    list new_world;
}


agent menager_by_lines {
    fields{
    }
    initialize{
    }
    beliefs{
        list my_world;
    }
    goals{
    }
    rules{
        when (bel.my_world) then {
            bel.my_world[1][1] = 5; 
            //print(bel.my_world);
        }
    }
    receive set_world {
        when () then {
            list world = [[0,1],[0,1]];
            do(after_get_world, [msg.new_world]);
        }
    }
    action after_get_world(list new_world): void {
        print("I am in action");
        sleep(1);
        bel.my_world = new_world;
    }
}


agent mother {
    fields{
        list WORLD;
    }
    initialize{
        self.WORLD = [[1,0,0],[0,0,0],[0,0,0]];
        //print(self.WORLD);
        agentid agentid_;
        agentid_ = spawn(menager_by_lines);
        msg_ = set_world(new_world=self.WORLD[:2]);
        send(agentid_, msg_, msg_type=request);
    }
    rules{
        when () then {
            print(self.WORLD);
        }
    }
}
message set_world{
    pointer<list> new_world;
}


agent menager_by_lines {
    fields{
    }
    initialize{
    }
    beliefs{
        pointer<list> my_world;
    }
    goals{
    }
    rules{
        when (bel.my_world) then {
            bel.my_world[0][0] = 5; 
        }
    }
    receive set_world {
        when () then {
            sleep(2);
            bel.my_world = msg.new_world;
        }
    }
}


agent mother {
    fields{
        list WORLD;
    }
    initialize{
        self.WORLD = [[1,0,0],[0,0,0],[0,0,0]];
        //print(self.WORLD);
        agentid agentid_;
        agentid_ = spawn(menager_by_lines);
        msg_ = set_world(new_world=&self.WORLD);
        send(agentid_, msg_, msg_type=request);
    }
    rules{
        when () then {
            print(self.WORLD);
        }
    }
}
agent mother {
    fields{
        list WORLD;
    }
    initialize{
        self.WORLD = [[0,0,0],[0,0,0],[0,0,0]];
        //print(self.WORLD);
        agentid agentid_;
        agentid_ = spawn(menager_by_lines, [&self.WORLD]);
    }
    rules{
        when () then {
            print(self.WORLD);
        }
    }
}
// ==== messages ========================
message UPDATE_MASTER_SCOUT{
    dict<tuple<int,int>, int> neighbor_map;
    tuple<int, int> pos;
    int reword;
}

message ACTUALIZE_SCOUT{
    dict<tuple<int,int>, int> to_visit;
    dict<tuple<int,int>, int> visited;
}

message ASK_FOR_PERMIRION{
    tuple<int, int> pos;
}


// ==== GREEN TEAM ========================
agent green_courrier{}

agent green_scout{
    fields {
        pointer<list<list<int>>> WORLD;
        tuple<int,int> START;

        list<tuple<int,int>> neighbors;
        list<tuple<int,int>> plan_path;
        tuple<int,int> target;
        tuple<int,int> found = (-1,-1);
        bool permition_to_go = False;
        bool answer = True;
    }
    beliefs {
        int x;
        int y;
        int reword;
        dict<tuple<int,int>, int> neighbor_map;
        dict<tuple<int,int>, int> to_visit;
        dict<tuple<int,int>, int> visited;
    }
    goals {
        g1: self.target == (bel.x, bel.y);
    }
    initialize {
        bel.x = self.START[0];
        bel.y = self.START[1];
        self.target = self.START;
        del self.plan_path[0];      // problem of initialize list of tuples in AGENTAR
    }
    sense {
        bel.neighbor_map = {};
        bel.reword = *self.WORLD[bel.y][bel.x];
        for (int i=0; i<4; i=i+1){
            tuple<int,int> neighbor = (bel.x + self.neighbors[i][0], bel.y + self.neighbors[i][1]);
            if (neighbor[0] < 0 || neighbor[0] >= len(*self.WORLD[0]) || neighbor[1] < 0 || neighbor[1] >= len(*self.WORLD)) continue;
            elif (*self.WORLD[neighbor[1]][neighbor[0]] == -1) continue;
            elif (bel.visited.get((neighbor[0],neighbor[1])) != None) continue;
            else  bel.neighbor_map[neighbor] = -2;         
            }
    }
    rules {
        when (self.is_goal_achieved == True && bel.visited.get((bel.x, bel.y)) == None) then {
            print("updating");
            bel.visited[(bel.x, bel.y)] = bel.reword;
            UPDATE_MASTER_SCOUT msg_ = UPDATE_MASTER_SCOUT{neighbor_map: bel.neighbor_map, pos: (bel.x, bel.y), reword: bel.reword};
            send2parent(msg_, msgType_inform);
        } 
        when (self.is_goal_achieved == True && self.permition_to_go == False && self.answer == True) then {
            print("looking for");
            do find_new_target();
            print("[ASK] found=", self.found, " plan_len=", len(self.plan_path));
            ASK_FOR_PERMIRION msg_ = ASK_FOR_PERMIRION{pos: self.found};
            if (self.found != (-1,-1)) {
                send2parent(msg_, msgType_request);
                self.answer = False;
            } else print("[ASK] skip: no target");
        }
        when (self.is_goal_achieved == False && self.permition_to_go == True && self.answer == True) then {
            self.permition_to_go = False;
            do go_to_target();
        }
    }
    receive ACTUALIZE_SCOUT {
        when () then {
            logging("Scout actualization");
            bel.to_visit = msg.to_visit;
            bel.visited = msg.visited;
        }
    }
    receive ASK_FOR_PERMIRION {
        when (msg._type == msgType_confirm) then {
            print("Permition confirm", msg.pos);
            del bel.to_visit[msg.pos];
            bel.visited[msg.pos] = bel.reword;
            self.permition_to_go = True;
            self.answer = True;
            self.target = msg.pos;
        }
        when (msg._type == msgType_deny) then {
            print("Permition deny", msg.pos);
            self.plan_path = [];
            self.permition_to_go = False;
            self.answer = True;
        }
    }

    action find_new_target(): void{
        dict<tuple<int,int>, tuple<int,int>> parent; // BFS tree (field: previous field)
        tuple<int, int> start = (bel.x, bel.y);
        parent[start] = start;
        list<tuple<int,int>> Q = [start];
        dict<tuple<int,int>, int> seen = {start: 1};
        tuple<int,int> found = (-1,-1);
        self.plan_path = [];
        while (len(Q)>0 && found == (-1,-1)){
            tuple<int,int> u = Q[0];
            del Q[0];
            if (bel.to_visit.get(u) != None) {found = u; break;}
            for (int i=0; i<4; i=i+1){
                tuple<int,int> neighbor = (u[0] + self.neighbors[i][0], u[1] + self.neighbors[i][1]);
                if (seen.get(neighbor) != None) continue;
                elif (bel.visited.get(neighbor) != None) {
                    seen[neighbor] = 1;
                    parent[neighbor] = u;
                    Q.add(neighbor);
                }
                elif (bel.to_visit.get(neighbor) != None) {
                    found = neighbor;
                    parent[found] = u;
                    break;
                }
            }
        }

        if (found == start) { self.found = (-1,-1); return; }

        if (found != (-1,-1) && found != start){
            self.found = found;
            tuple<int,int> curr = found;
            while (curr != start) {
                self.plan_path.add(curr);
                curr = parent[curr];
            }
        }
    }

    action go_to_target(): void {
        while (len(self.plan_path)>0){
            tuple<int, int> target = (self.plan_path[-1][0], self.plan_path[-1][1]);
            if (target[0] < 0 || target[0] >= len(*self.WORLD[0]) || target[1] < 0 || target[1] >= len(*self.WORLD)) {self.plan_path = []; return;} // target out of the world
            bel.x = target[0];
            bel.y = target[1];
            del self.plan_path[-1];
            print("GREEN POSSITION::", (bel.x, bel.y));
        }
    }
}


agent green_scout_master{
    fields {
        pointer<list<list<int>>> WORLD;
        tuple<int,int> START;
    }
    beliefs {
        dict<tuple<int,int>, int> to_visit;
        dict<tuple<int,int>, int> visited;
    }
    goals {
        g1: len(bel.to_visit) == 0;
    }
    initialize {
        spawn(green_scout, {WORLD: self.WORLD, START: self.START, neighbors: [(1,0),(0,1),(-1,0),(0,-1)]});
        //spawn(green_scout, {WORLD: self.WORLD, START: self.START, neighbors: [(0,1),(-1,0),(0,-1),(1,0)]});
        //spawn(green_scout, {WORLD: self.WORLD, START: self.START, neighbors: [(-1,0),(0,-1),(1,0),(0,1)]});
        //spawn(green_scout, {WORLD: self.WORLD, START: self.START, neighbors: [(0,-1),(1,0),(0,1),(-1,0)]});
    }
    receive UPDATE_MASTER_SCOUT{
        when () then {
            logging("actualize the world");
            list<tuple<int,int>> keys;
            keys = msg.neighbor_map.keys();
            for (int i = 0; i < len(msg.neighbor_map); i=i+1){
                if (bel.visited.get(keys[i]) == None)
                    bel.to_visit[ keys[i] ] = msg.neighbor_map[keys[i]];
            }
            bel.visited[msg.pos] = msg.reword;
            ACTUALIZE_SCOUT msg_ = ACTUALIZE_SCOUT{to_visit: bel.to_visit, visited: bel.visited};
            send2children(_, msg_, msgType_inform);
        }
    }
    receive ASK_FOR_PERMIRION {
        when (msg._type == msgType_request) then {
            ASK_FOR_PERMIRION msg_ = ASK_FOR_PERMIRION{pos: msg.pos};
            if (bel.to_visit.get(msg.pos) != None) {
                send(msg._sender, msg_, msgType_confirm);
                del bel.to_visit[msg.pos];
                ACTUALIZE_SCOUT msg_ = ACTUALIZE_SCOUT{to_visit: bel.to_visit, visited: bel.visited};
                send2children(_, msg_, msgType_inform);
            }
            else send(msg._sender, msg_, msgType_deny);
        }
    }
}

agent green_master{
    fields {
        pointer<list<list<int>>> WORLD;
        tuple<int,int> START;
    }
    beliefs {
        dict<tuple<int, int>, int> map;
        dict<tuple<int, int>, int> reword;

    }
    initialize {
        print("MY TEAM::: GREEN");
        spawn(green_scout_master, {WORLD: self.WORLD, START: self.START});
    }
}




agent mother {
    fields{
        //int x = 4;
        list<int> l = [0,1];
    }
    initialize {
        list<int> l = [0,1];
        //do run(l);
        do run2(&self.l);
        //print("Out:: ", l);
    } 
    action run(list<int> l): void {
        print(l);
        l[0] = 100;
        print(l);
    }
    action run2(pointer<list<int>> l): void {
        print(l);
        print(*l);
        *l[0] = 100;
        print(*l);
    }
}
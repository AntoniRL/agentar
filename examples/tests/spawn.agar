message mmm{
    int i;
}

agent child{
    fields{
        list<int> i;
        pointer<list<int>> l;
    }
    initialize{
        print("Hello I am child of", self._parent);
        //self.i[0] = 111;
        *self.l[0] = 111;
        print(self.i);
        print(*self.l);
    }
}

agent mother{
    initialize{
        list<int> l = [0,1,0];
        agentid id_;
        id_ = spawn(child, {i: l, l: &l});
        sleep(0.5);
        print(l);
        kill();
    }
}
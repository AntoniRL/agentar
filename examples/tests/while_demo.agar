agent mother {
    initialize{
        print("--- WHILE demo: shadowing and parent:: ---");
        int i = 0; // loop variable
        print("outer i before while =", i);

        while (i < 5) {
            print("while top, i =", i);

            // create a nested block to shadow 'i' and access parent::i
            if (True) {
                int i = 100 + parent::i; // shadowed inner i
                print("inner shadow i =", i);
                print("parent::i (loop var) =", parent::i);
            }

            i = i + 1;

            if (i == 2) {
                print("continue at i == 2");
                continue;
            }
            if (i == 4) {
                print("break at i == 4");
                break;
            }

            print("while bottom, i =", i);
        }

        print("after while, i =", i);
        kill();
    }
}
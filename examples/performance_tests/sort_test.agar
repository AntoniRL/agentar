    action bubble_sort(list<int> l): void {
        bool changed = True;
        int counter = 0;
        while (changed == True) {
            changed = False;
            for (int i=0; i < len(l) - counter - 1; i=i+1){
                if (l[i] > l[i+1]){
                    changed = True;
                    int temp = l[i];
                    l[i] = l[i+1];
                    l[i+1] = temp;
                }
            }
            counter = counter + 1;
        }
        //print(l);
    }

// ==== messages ========================
message TASK_ANSWER{
    dict<tuple<int,int>, int> to_visit;
    dict<tuple<int,int>, int> visited;
}

message TAKS_REQUEST{
    dict<tuple<int,int>, int> new_to_visit;
    tuple<int,int> potential_target;
}

message TASK_DONE{

}

message ACTUALIZE_SCOUT{
    dict<tuple<int,int>, int> to_visit;
    dict<tuple<int,int>, int> visited;
}


// ==== GREEN TEAM ========================
agent green_courrier{}

agent green_scout{
    fields {
        pointer<list<list<int>>> WORLD;
        tuple<int,int> START;
        list<tuple<int,int>> neighbors;

        list<tuple<int,int>> plan_path;
        tuple<int,int> target;
        tuple<int,int> found = (-1,-1);
        tuple<int,int> potential_target;
        bool permition_to_go = False;
        bool answer = True;
    }
    beliefs {
        int x;
        int y;
        int reword;
        //dict<tuple<int,int>, int> neighbor_map;
        dict<tuple<int,int>, int> to_visit;
        dict<tuple<int,int>, int> to_visit_local;
        dict<tuple<int,int>, int> visited;
        dict<tuple<int,int>, int> visited_local;
    }
    goals {
        g1: self.target == (bel.x, bel.y);
    }
    initialize {
        bel.x = self.START[0];
        bel.y = self.START[1];
        self.target = self.START;
        del self.plan_path[0];      // problem of initialize list of tuples in AGENTAR
        bel.visited[self.START] = 0;
    }
    sense {
        bel.reword = *self.WORLD[bel.y][bel.x];
        for (int i=0; i<4; i=i+1){
            tuple<int,int> neighbor = (bel.x + self.neighbors[i][0], bel.y + self.neighbors[i][1]);
            if (neighbor[0] < 0 || neighbor[0] >= len(*self.WORLD[0]) || neighbor[1] < 0 || neighbor[1] >= len(*self.WORLD)) continue;
            elif (*self.WORLD[neighbor[1]][neighbor[0]] == -1) continue;
            elif (bel.visited.get((neighbor[0],neighbor[1])) != None) continue;
            else  bel.to_visit_local[neighbor] = -2;
        }
    }
    rules {
        when (self.is_goal_achieved && self.answer == True && self.permition_to_go == False) then {
            self.answer = False;
            //do find_new_target();  
            self.potential_target = (1,0);
            TAKS_REQUEST rq = TAKS_REQUEST{new_to_visit: bel.to_visit_local, potential_target: self.potential_target};
            send2parent(rq, msgType_request);
            bel.to_visit_local = {};
        }
    }
    receive TASK_ANSWER {
        when () then {
            print(msg.to_visit);
        }
    }
}


agent green_scout_master{
    fields {
        pointer<list<list<int>>> WORLD;
        tuple<int,int> START;
    }
    beliefs {
        dict<tuple<int,int>, int> to_visit; //1== open licitation; 0==reserved; -1==done;
        dict<tuple<int,int>, int> visited;
    }
    goals {
        g1: len(bel.to_visit) == 0;
    }
    initialize {
        bel.to_visit[self.START] = 1;
        spawn(green_scout, {WORLD: self.WORLD, START: self.START, neighbors: [(1,0),(0,1),(-1,0),(0,-1)]});
        spawn(green_scout, {WORLD: self.WORLD, START: self.START, neighbors: [(0,1),(-1,0),(0,-1),(1,0)]});
        //spawn(green_scout, {WORLD: self.WORLD, START: self.START, neighbors: [(-1,0),(0,-1),(1,0),(0,1)]});
        //spawn(green_scout, {WORLD: self.WORLD, START: self.START, neighbors: [(0,-1),(1,0),(0,1),(-1,0)]});
    }
    receive TAKS_REQUEST{
        when (msgType_request) then {
            // ==== actualize the map
            list<tuple<int,int>> keys;
            keys = msg.new_to_visit.keys();
            for (int i = 0; i < len(keys); i=i+1){
                if (bel.visited.get(keys[i]) == None)
                    bel.to_visit[ keys[i] ] = msg.new_to_visit[keys[i]];
            }
            if (bel.to_visit.get(msg.potential_target) == 1){
                print("TAKE IT");
                bel.reserved[msg.potential_target] = 1;
                del bel.to_visit[msg.potential_target];
                //TASK_ANSWER ta = TASK_ANSWER{};
                //send(msg.sender, ta, msgType_confirm);
            } 
        }
    }
}

agent green_master{
    fields {
        pointer<list<list<int>>> WORLD;
        tuple<int,int> START;
    }
    beliefs {
        dict<tuple<int, int>, int> map;
        dict<tuple<int, int>, int> reword;

    }
    initialize {
        print("MY TEAM::: GREEN");
        spawn(green_scout_master, {WORLD: self.WORLD, START: self.START});
    }
}




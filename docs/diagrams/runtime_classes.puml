@startuml
title Agentar — Runtime class diagram (runtime only)

' Classes
class AgentarSystem {
  - mother_decl
  - agents_decl
  - messages_decl
  - agents: dict[AgentId, AgentInstance]
  - threads: dict[AgentId, AgentRunner]
  + start()
  + stop()
  + send_message(message)
  + spawn_agent(parentInstance, agent_type, fields)
  + kill_agent(agent_id)
}

class AgentRunner {
  - instance: AgentInstance
  - system: AgentarSystem
  - agent_id: AgentId
  - tick_interval
  + run()
  + stopAgent()
}

class AgentInstance {
  - _id: AgentId
  - _parent: AgentId
  - _children: List[AgentId]
  - _inbox: Queue[MessageInstance]
  - _runtime: AgentarSystem
  - _executor: StatementExecutor
  - _evaluator: ExpressionEvaluator
  - _message_handler: MessageHandler
  - _action_executor: ActionExecutor
  + initializeAgent()
  + step()
  + destroyAgent()
}

class StatementExecutor
class ExpressionEvaluator {
  - agent: AgentInstance
}
class MessageHandler {
  - agent: AgentInstance
}
class ActionExecutor {
  - agent: AgentInstance
}

class AgentarAgent {
  - _fields: VariableContainer
  - _beliefs: VariableContainer
  - _actions: ASTNodeContainer
  - _initialize
  - _destroy
  - _name
}

class AgentarMessage
class MessageInstance {
  - _name: str
  - _sender: AgentId
  - _receiver: AgentId
  - _type
  - _content: VariableContainer
}

class AgentContainer
class MessageContainer
class VariableContainer {
  - _variables: dict[str, VariableInfo]
  - _agent: AgentInstance
}
class VariableInfo
class Pointer
class TypedList
class TypedDict
class TypedTuple
class AgentId


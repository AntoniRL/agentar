class MismatchTypeWithDeclarationError
class MismatchMessageContentError
class FieldWithNoneValueError
class NotAssignableError
class MinusValueForSquare

AgentarRuntimeError <|-- VariableNotFoundError
AgentarRuntimeError <|-- VariableAlreadyDeclaredError
AgentarRuntimeError <|-- AgentNameAlreadyDeclaredError
AgentarRuntimeError <|-- AgentNotFoundError
AgentarRuntimeError <|-- MessageAlreadyDeclaredError
AgentarRuntimeError <|-- MessageNotFoundError
AgentarRuntimeError <|-- ASTNodeAlreadyDeclaredError
AgentarRuntimeError <|-- ASTNodeNotFoundError
AgentarRuntimeError <|-- WrongTypeError
AgentarRuntimeError <|-- IndexOutOfRangeError
AgentarRuntimeError <|-- KeyNotFoundError
AgentarRuntimeError <|-- UnsupportedOperatorError
AgentarRuntimeError <|-- NoValueInActionCall
AgentarRuntimeError <|-- MismatchTypeWithDeclarationError
AgentarRuntimeError <|-- MismatchMessageContentError

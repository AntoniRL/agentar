class VariableNotFoundError
class VariableAlreadyDeclaredError
class AgentNameAlreadyDeclaredError
class AgentNotFoundError
class MessageAlreadyDeclaredError
class MessageNotFoundError
class ASTNodeAlreadyDeclaredError
class ASTNodeNotFoundError
class WrongTypeError
class IndexOutOfRangeError
class KeyNotFoundError
class UnsupportedOperatorError
